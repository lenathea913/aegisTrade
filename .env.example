# AegisTrade environment template.
# Copy to .env and fill in locally. .env is gitignored - never commit real values.
#
# Naming: AEGIS_<SECTION>__<FIELD> overrides anything in configs/*.yaml.
# Precedence: env vars > .env > configs/<environment>.yaml > configs/base.yaml.
# Everything here is a placeholder; secrets stay empty until you set them.

AEGIS_ENVIRONMENT=dev

# --- Postgres (source of truth for ledger + audit) ---------------------------
AEGIS_DATABASE__URL=postgresql+psycopg://aegis:change-me@localhost:5432/aegis
AEGIS_DATABASE__POOL_SIZE=5
AEGIS_DATABASE__ECHO=false

# --- Redis (queue / cache only, NOT source of truth) ------------------------
AEGIS_REDIS__URL=redis://localhost:6379/0

# --- Execution ---------------------------------------------------------------
# paper | live. live is inert in this MVP and additionally requires
# execution.allow_live_orders=true in configs/live.yaml.
AEGIS_EXECUTION__MODE=paper
# spot | futures — futures runs on Binance Futures Testnet only
AEGIS_EXECUTION__MARKET_TYPE=spot
# Hard ceiling for dynamic leverage (1-5; anything above 5 is refused at startup)
AEGIS_EXECUTION__MAX_LEVERAGE=5
AEGIS_EXECUTION__ALLOW_LIVE_ORDERS=false

# --- Exchange credentials (never logged, never committed) -------------------
# Read only from the environment; leave empty in paper mode.
AEGIS_EXCHANGE__ID=binance
AEGIS_EXCHANGE__API_KEY=
AEGIS_EXCHANGE__API_SECRET=
AEGIS_EXCHANGE__TESTNET=true
# Testnet REST endpoint only; a non-testnet host raises unless AEGIS_LIVE_CONFIRM=true.
AEGIS_EXCHANGE__BASE_URL=https://testnet.binance.vision

# --- Live confirmation --------------------------------------------------------
# Very deliberate opt-in: lets the Binance adapter accept a non-testnet base URL.
# Leave false while this project is still paper/testnet only.
AEGIS_LIVE_CONFIRM=false

# --- Alerting (Telegram) ------------------------------------------------------
# Alerting is on: with no channel every alert goes to the structured log. To deliver
# out of band, set CHANNELS=["telegram"] AND both credentials below; naming a channel
# with an empty token fails at startup on purpose (silently unconfigured alerting is
# worse than no alerting). Tokens are SecretStr and never logged.
AEGIS_ALERTING__ENABLED=true
AEGIS_ALERTING__CHANNELS=[]
AEGIS_ALERTING__TELEGRAM_BOT_TOKEN=
AEGIS_ALERTING__TELEGRAM_CHAT_ID=
AEGIS_ALERTING__RATE_LIMIT_SECONDS=2
AEGIS_ALERTING__DEDUPE_SECONDS=60

# --- Real-time marks + reconciliation ----------------------------------------
AEGIS_STREAMING__ENABLED=false
AEGIS_STREAMING__MARK_TTL_SECONDS=15
AEGIS_RECONCILER__INTERVAL_SECONDS=5

# --- Market data -------------------------------------------------------------
# source: csv            committed seeds in data/seeds (offline, deterministic)
#         exchange       public Binance klines API
#         binance        the same live klines API as `exchange`
# Anything else fails at startup instead of silently falling back to CSV.
AEGIS_MARKET_DATA__SOURCE=binance
AEGIS_MARKET_DATA__CSV_DIR=data/seeds
# Freshness budget for risk rule 8. Leave the pin empty to derive it per timeframe:
# one bar + collector interval + tolerance (1h -> 3720 s). Only set a number to override.
# AEGIS_MARKET_DATA__STALE_AFTER_SECONDS=
AEGIS_MARKET_DATA__COLLECTOR_INTERVAL_SECONDS=60
AEGIS_MARKET_DATA__STALE_TOLERANCE_SECONDS=60

# --- Risk --------------------------------------------------------------------
# Kill switch: true halts all execution immediately (see docs/runbooks/kill-switch.md).
AEGIS_RISK__KILL_SWITCH=false

# --- Prometheus alert bridge -------------------------------------------------
# apps/alert_bridge polls these rules and forwards firing alerts through the alerter.
# Use the compose service name from inside a container (the default); a host-run CLI
# needs http://localhost:9090 instead.
AEGIS_PROMETHEUS__URL=http://prometheus:9090
AEGIS_PROMETHEUS__ALERT_POLL_SECONDS=30

# --- API security ------------------------------------------------------------
# Bearer token for /api/*, the dashboard pages and the HTMX partials.
# /health and /metrics stay open. Empty = development mode (open + startup warning).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_API_TOKEN=

# --- Autonomous runner -------------------------------------------------------
AEGIS_RUNNER__SIGNAL_INTERVAL_SECONDS=300
AEGIS_RUNNER__MONITOR_INTERVAL_SECONDS=60
AEGIS_RUNNER__MONITOR_ENABLED=true
AEGIS_POSITION_MONITOR__USE_LIVE_PRICE=false

# --- Observability -----------------------------------------------------------
AEGIS_OBSERVABILITY__LOG_LEVEL=INFO
AEGIS_OBSERVABILITY__JSON_LOGS=true
AEGIS_OBSERVABILITY__METRICS_ENABLED=true
AEGIS_OBSERVABILITY__METRICS_PORT=9101

# --- Compose stacks (read by docker compose, not by the application) ---------
# Development defaults only. Change both before exposing the stack anywhere.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
